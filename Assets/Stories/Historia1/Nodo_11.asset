  m_Name: Nodo_11
  m_EditorClassIdentifier: 
  id: 7
  texto: "Lleg\xE1s.\n\nLe mostr\xE1s la grabaci\xF3n a la fiscal de turno.\n\nLa
    escucha dos veces.\n\nSe pone de pie.\n\n\u2014\"\xBFSab\xE9s lo que acab\xE1s
    de traer?\"\n\n\u2014\"\xBFTen\xE9s respaldo de esto?\"\n\nNo ten\xE9s.\n\nEl
    celular es la \xFAnica copia."
  imagen: {fileID: 0}
  opciones:
  - texto: "Dejar el celular en la fiscal\xEDa"
    costo: 150
    siguienteNodo: {fileID: 11400000, guid: 65fd7e753779a0448b9fd9921583aaf9, type: 2}
  - texto: "Pedir protecci\xF3n primero"
    costo: 200
    siguienteNodo: {fileID: 11400000, guid: 6ea0065181009634f8f6034b7eb8f7d6, type: 2}
