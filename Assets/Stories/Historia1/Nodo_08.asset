  m_Name: Nodo_08
  m_EditorClassIdentifier: 
  id: 7
  texto: "La escuch\xE1s.\n\nTu voz dice algo sobre un operativo.\n\nLa voz de tu
    superior responde:\n\n\u2014\"Cuando termine, \xE9l no puede seguir existiendo.\"\n\nSilencio.\n\n\u2014\"\xBFY
    si pregunta?\"\n\n\u2014\"No va a tener tiempo.\"\n\nLa grabaci\xF3n termina.\n\nAhora
    entend\xE9s todo.\n\nNecesit\xE1s a alguien que pueda usar esto."
  imagen: {fileID: 0}
  opciones:
  - texto: "Ir a la fiscal\xEDa"
    costo: 300
    siguienteNodo: {fileID: 11400000, guid: 5a336b6c03414f2438781a73b10e3b54, type: 2}
  - texto: "Buscar al n\xFAmero desconocido"
    costo: 250
    siguienteNodo: {fileID: 11400000, guid: 2e498f646797c0545877d5500bdd80ef, type: 2}
